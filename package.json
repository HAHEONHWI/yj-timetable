{
  "name": "yj-timetable-widget",
  "version": "1.0.0",
  "description": "Yongjeong timetable desktop widget",
  "author": "하헌휘",
  "main": "widget/main.js",
  "private": true,
  "scripts": {
    "start:widget": "electron .",
    "dist:win": "electron-builder --win nsis --x64",
    "check:client": "node --check src/app-utils.js && node --check src/app.js && node --check src/storage.js && node --check src/timetable-import.js && node --check netlify/functions/meal.js && node --check netlify/functions/wallpaper.js",
    "check:functions": "deno check supabase/functions/*/index.ts",
    "test:client": "node --test tests/*.test.js",
    "test:functions": "deno test supabase/functions/_shared/*.test.ts",
    "test": "npm run check:client && npm run check:functions && npm run test:client && npm run test:functions",
    "audit:production": "npm audit --omit=dev --package-lock-only",
    "prepare:netlify": "sh scripts/prepare-netlify-deploy.sh",
    "deploy:netlify": "NETLIFY_DEPLOY_DIR=/private/tmp/timetable-netlify-deploy npm run prepare:netlify && npx netlify deploy --prod --dir=/private/tmp/timetable-netlify-deploy"
  },
  "build": {
    "appId": "kr.yjms.timetable.widget",
    "productName": "용정시간표-Widget",
    "files": [
      "assets/**/*",
      "src/storage.js",
      "src/supabase-config.js",
      "widget/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/logo.png"
    },
    "nsis": {
      "artifactName": "용정시간표-Widget-Setup.exe",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "용정시간표-Widget"
    }
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@resvg/resvg-js-linux-x64-gnu": "^2.6.2"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
