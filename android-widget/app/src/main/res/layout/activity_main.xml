            <TextView android:id="@+id/app_header_day_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="목" android:textColor="#f8fafc" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:background="#0f172a" android:layout_margin="0.5dp" />
