<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f172a">

    <!-- 상단 앱 헤더 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#090d16"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/app_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="용정시간표 조회 및 설정"
            android:textColor="#2dd4bf"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="실시간 연동됨"
            android:textColor="#64748b"
            android:textSize="12sp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
            
    </RelativeLayout>

    <!-- 실시간 조회 대시보드 (앱 내부 5x9 네이티브 시간표 텍스트 격자판) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:orientation="vertical"
        android:background="#334155"
        android:padding="1dp"
        android:layout_margin="10dp">

        <!-- 요일 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8"
            android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.8" android:text="교시" android:textColor="#94a3b8" android:textSize="9sp" android:textStyle="bold" android:gravity="center" android:background="#0f172a" android:layout_margin="0.5dp" />
            <TextView android:id="@+id/app_header_day_0" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="월" android:textColor="#f8fafc" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:background="#0f172a" android:layout_margin="0.5dp" />
            <TextView android:id="@+id/app_header_day_1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="화" android:textColor="#f8fafc" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:background="#0f172a" android:layout_margin="0.5dp" />
            <TextView android:id="@+id/app_header_day_2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="수" android:textColor="#f8fafc" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:background="#0f172a" android:layout_margin="0.5dp" />
            <TextView android:id="@+id/app_header_day_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="목" android:textColor="#f8fafc" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:background="#0f172a" android:layout_margin="0.5dp" />
            <TextView android:id="@+id/app_header_day_4" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="금" android:textColor="#f8fafc" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:background="#0f172a" android:layout_margin="0.5dp" />
        </LinearLayout>

        <!-- 1~9교시 (ID: app_cell_d_p) -->
        <!-- 1교시 -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
            <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.8" android:text="1" android:textColor="#94a3b8" android:textSize="10sp" android:textStyle="bold" android:gravity="center" android:background="#0f172a" android:layout_margin="0.5dp" />
