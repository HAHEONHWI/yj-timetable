<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f172a">

    <!-- 상단 대시보드 타이틀 -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#090d16"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="용정시간표 조회 및 설정"
            android:textColor="#2dd4bf"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true" />

        <TextView
            android:id="@+id/txt_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="실시간 동기화됨"
            android:textColor="#64748b"
            android:textSize="12sp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
            
    </RelativeLayout>

    <!-- 실시간 조회 대시보드 (WebView) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:background="#1e293b">

        <WebView
            android:id="@+id/web_dashboard"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
            
    </FrameLayout>

    <!-- 구분선 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1e293b" />

    <!-- 하단 접이식 설정 카드 (스크롤뷰 지원) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 설정 카드 영역 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="필터링 조건 편집"
                    android:textColor="#f8fafc"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp" />

                <!-- 선생님 이름 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="선생님 이름"
                    android:textColor="#2dd4bf"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edit_name"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#0f172a"
                    android:textColor="#f8fafc"
                    android:hint="예: 최세영"
                    android:textColorHint="#475569"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <!-- 강조 과목 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="강조 과목 (쉼표 구분)"
                    android:textColor="#2dd4bf"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edit_subjects"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#0f172a"
                    android:textColor="#f8fafc"
                    android:hint="예: 영어"
                    android:textColorHint="#475569"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <!-- 학년/반 필터 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="학년/반 필터"
                    android:textColor="#2dd4bf"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edit_grades"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#0f172a"
                    android:textColor="#f8fafc"
                    android:hint="예: 영어:1|2"
                    android:textColorHint="#475569"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:singleLine="true"
                    android:layout_marginBottom="14dp" />

                <!-- 요일 필터 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="표시할 요일 (쉼표 구분)"
                    android:textColor="#2dd4bf"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edit_days"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#0f172a"
                    android:textColor="#f8fafc"
                    android:hint="예: mon,tue,wed,thu,fri"
                    android:textColorHint="#475569"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:singleLine="true" />
                    
            </LinearLayout>

            <!-- 저장 및 갱신 버튼 -->
            <Button
                android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="#14b8a6"
                android:text="수정사항 저장 및 위젯 적용"
                android:textColor="#0f172a"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/txt_copyright"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="저작권 23기 하헌휘"
                android:textColor="#475569"
                android:textSize="11sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
