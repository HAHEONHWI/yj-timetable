            <TextView android:id="@+id/app_cell_2_3" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:textColor="#f8fafc" android:textSize="8sp" android:gravity="center" android:background="#1e293b" android:layout_margin="0.5dp" />
