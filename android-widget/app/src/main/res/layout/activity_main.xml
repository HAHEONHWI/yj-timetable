    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1e293b" />

    <!-- 하단 스크롤 설정 폼 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. 선생님 이름 입력 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="선생님 이름"
                    android:textColor="#2dd4bf"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/edit_name_native"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#0f172a"
                    android:textColor="#f8fafc"
                    android:hint="예: 최세영"
                    android:textColorHint="#475569"
                    android:paddingHorizontal="12dp"
                    android:textSize="14sp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- 2. 요일 다중 선택 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="표시할 요일"
                    android:textColor="#2dd4bf"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/chk_mon" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="월" android:textColor="#f8fafc" android:textSize="13sp"/>
                    <CheckBox android:id="@+id/chk_tue" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="화" android:textColor="#f8fafc" android:textSize="13sp"/>
                    <CheckBox android:id="@+id/chk_wed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="수" android:textColor="#f8fafc" android:textSize="13sp"/>
                    <CheckBox android:id="@+id/chk_thu" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="목" android:textColor="#f8fafc" android:textSize="13sp"/>
                    <CheckBox android:id="@+id/chk_fri" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="금" android:textColor="#f8fafc" android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 3. 학년 다중 선택 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="대상 학년"
                    android:textColor="#2dd4bf"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/chk_grade_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="1학년" android:textColor="#f8fafc" android:textSize="13sp"/>
                    <CheckBox android:id="@+id/chk_grade_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="2학년" android:textColor="#f8fafc" android:textSize="13sp"/>
                    <CheckBox android:id="@+id/chk_grade_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="3학년" android:textColor="#f8fafc" android:textSize="13sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 4. 강조 과목 다중 선택 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="내 담당 과목"
                    android:textColor="#2dd4bf"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">
                    <CheckBox android:id="@+id/chk_sub_eng" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="영어" android:textColor="#f8fafc" android:textSize="12sp"/>
                    <CheckBox android:id="@+id/chk_sub_math" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="수학" android:textColor="#f8fafc" android:textSize="12sp"/>
                    <CheckBox android:id="@+id/chk_sub_kor" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="국어" android:textColor="#f8fafc" android:textSize="12sp"/>
                    <CheckBox android:id="@+id/chk_sub_sci" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="과학" android:textColor="#f8fafc" android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <CheckBox android:id="@+id/chk_sub_soc" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="사회" android:textColor="#f8fafc" android:textSize="12sp"/>
                    <CheckBox android:id="@+id/chk_sub_his" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="역사" android:textColor="#f8fafc" android:textSize="12sp"/>
                    <CheckBox android:id="@+id/chk_sub_pe" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="체육" android:textColor="#f8fafc" android:textSize="12sp"/>
                    <CheckBox android:id="@+id/chk_sub_mus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="음악" android:textColor="#f8fafc" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 실시간 동기화 저장 버튼 -->
            <Button
                android:id="@+id/btn_save_native"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#14b8a6"
                android:text="설정 저장 및 바탕화면 위젯 동기화"
                android:textColor="#0f172a"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <!-- 5. 관리자 로그인 카드 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="관리자 로그인"
                    android:textColor="#f59e0b"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <EditText
                        android:id="@+id/edit_admin_pw"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1.5"
                        android:background="#0f172a"
                        android:textColor="#f8fafc"
                        android:hint="관리자 패스워드"
                        android:textColorHint="#475569"
                        android:paddingHorizontal="10dp"
                        android:textSize="13sp"
                        android:inputType="textPassword"
                        android:singleLine="true" />

                    <Button
                        android:id="@+id/btn_admin_login"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginLeft="8dp"
                        android:background="#334155"
                        android:text="로그인"
                        android:textColor="#f8fafc"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txt_admin_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="비로그인 상태 (변경 불가)"
                    android:textColor="#94a3b8"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 6. 수업 변경 등록 카드 (로그인 성공 시 visible) -->
            <LinearLayout
                android:id="@+id/card_admin_change"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="수업 변경 등록 (관리자)"
                    android:textColor="#2dd4bf"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- 날짜 선택 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="변경 날짜"
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edit_change_date"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#0f172a"
                    android:textColor="#f8fafc"
                    android:hint="터치하여 날짜 선택 (YYYY-MM-DD)"
                    android:textColorHint="#475569"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_marginBottom="10dp" />

                <!-- 학급 및 교시 선택 (가로 정렬) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginRight="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="학급"
                            android:textColor="#94a3b8"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp" />
                        <Spinner
                            android:id="@+id/spn_change_class"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#0f172a"
                            android:entries="@array/array_classes" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginLeft="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="교시"
                            android:textColor="#94a3b8"
                            android:textSize="11sp"
                            android:layout_marginBottom="4dp" />
                        <Spinner
                            android:id="@+id/spn_change_period"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:background="#0f172a"
                            android:entries="@array/array_periods" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 변경 후 과목 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="변경 후 과목명"
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edit_change_subject"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#0f172a"
                    android:textColor="#f8fafc"
                    android:hint="예: 영어 (결강 시 '-' 입력)"
                    android:textColorHint="#475569"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:layout_marginBottom="12dp" />

                <!-- 변경 등록 버튼 -->
                <Button
                    android:id="@+id/btn_add_change"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#f59e0b"
                    android:text="수업 변경사항 DB 등록"
                    android:textColor="#0f172a"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 7. 학교 행사 등록 카드 (로그인 성공 시 visible) -->
            <LinearLayout
                android:id="@+id/card_admin_event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1e293b"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="학교 행사 등록 (관리자)"
                    android:textColor="#2dd4bf"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- 행사 날짜 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="행사 날짜"
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edit_event_date"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#0f172a"
                    android:textColor="#f8fafc"
                    android:hint="터치하여 날짜 선택 (YYYY-MM-DD)"
                    android:textColorHint="#475569"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:focusable="false"
                    android:clickable="true"
                    android:layout_marginBottom="10dp" />

                <!-- 행사 제목 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="행사 제목"
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edit_event_title"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#0f172a"
                    android:textColor="#f8fafc"
                    android:hint="예: 중간고사"
                    android:textColorHint="#475569"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:layout_marginBottom="10dp" />

                <!-- 행사 설명 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="행사 상세 설명"
                    android:textColor="#94a3b8"
                    android:textSize="11sp"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edit_event_desc"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#0f172a"
                    android:textColor="#f8fafc"
                    android:hint="예: 1~3학년 전체 대상"
                    android:textColorHint="#475569"
                    android:paddingHorizontal="10dp"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:layout_marginBottom="12dp" />

                <!-- 행사 등록 버튼 -->
                <Button
                    android:id="@+id/btn_add_event"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="#2dd4bf"
                    android:text="학교 행사 DB 등록"
                    android:textColor="#0f172a"
                    android:textStyle="bold"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_copyright"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="저작권 23기 하헌휘"
                android:textColor="#475569"
                android:textSize="11sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
